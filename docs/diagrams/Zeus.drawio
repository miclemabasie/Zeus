      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph ConfigManager_Module[\&quot;Configuration Manager\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State\&quot;]\n            PATH[\&quot;config_path_ (string)\&quot;]\n            DATA[\&quot;JSON Object (nlohmann::json)\&quot;]\n            WATCH[\&quot;File Watcher (optional)\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface (Getters)\&quot;]\n            G1[\&quot;collector_port() -&gt; int\&quot;]\n            G2[\&quot;queue_max_size() -&gt; size_t\&quot;]\n            G3[\&quot;worker_count() -&gt; size_t\&quot;]\n            G4[\&quot;storage_dir() -&gt; string\&quot;]\n            G5[\&quot;index_fields() -&gt; vector&lt;string&gt;\&quot;]\n            G6[\&quot;log_level() -&gt; Level\&quot;]\n            G7[\&quot;... and many more\&quot;]\n        end\n\n        subgraph Internal_Logic[\&quot;Load &amp; Validate\&quot;]\n            V1[\&quot;Open config.json\&quot;]\n            V2[\&quot;Parse JSON\&quot;]\n            V3{\&quot;Required fields present?\&quot;}\n            V4[\&quot;Store values internally\&quot;]\n            V5[\&quot;Throw / Log Error\&quot;]\n            \n            V1 --&gt; V2 --&gt; V3\n            V3 -- Yes --&gt; V4\n            V3 -- No --&gt; V5\n        end\n\n        subgraph Hot_Reload[\&quot;Hot-Reload (Optional)\&quot;]\n            H1[\&quot;File watcher detects change\&quot;]\n            H2[\&quot;Reload JSON\&quot;]\n            H3[\&quot;Notify registered listeners\&quot;]\n        end\n\n        G1 -.-&gt; DATA\n        V4 --&gt; DATA\n        H3 --&gt; G1\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5fs0gFkaQeqwkAi5dB84-1">

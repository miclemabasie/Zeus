        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph QueryEngine_Module[\&quot;Query Engine\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State / Dependencies\&quot;]\n            DEP1[\&quot;Reference to IndexEngine\&quot;]\n            DEP2[\&quot;Reference to StorageEngine\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface\&quot;]\n            I1[\&quot;search(query) -&gt; QueryResult\&quot;]\n            I2[\&quot;tail(callback) -&gt; void (live stream)\&quot;]\n        end\n\n        subgraph Search_Flow[\&quot;search() Execution Plan\&quot;]\n            Q1[\&quot;Parse Query Object\\n(fields, time_range, message_filter)\&quot;]\n            Q2[\&quot;Consult IndexEngine\\nto get candidate StorageLocations\&quot;]\n            Q3{\&quot;Candidate set empty?\&quot;}\n            Q4[\&quot;For each Location:\\n storage-&gt;read(loc)\&quot;]\n            Q5[\&quot;Apply non-indexed filters\\n(regex on message, time range)\&quot;]\n            Q6[\&quot;Sort results by timestamp\&quot;]\n            Q7[\&quot;Apply Pagination\\n(offset, limit)\&quot;]\n            Q8[\&quot;Return QueryResult\&quot;]\n            \n            Q1 --&gt; Q2 --&gt; Q3\n            Q3 -- Yes --&gt; Q8\n            Q3 -- No --&gt; Q4 --&gt; Q5 --&gt; Q6 --&gt; Q7 --&gt; Q8\n        end\n\n        subgraph Tail_Flow[\&quot;tail() Live Streaming\&quot;]\n            T1[\&quot;Subscribe to new logs\\n(e.g., via queue or callback)\&quot;]\n            T2[\&quot;Filter based on tail criteria\&quot;]\n            T3[\&quot;Invoke user callback with log\&quot;]\n            \n            T1 --&gt; T2 --&gt; T3\n        end\n\n        I1 --&gt; Search_Flow\n        I2 --&gt; Tail_Flow\n    end\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hc-PRelSRCM6ZAvarKP--1">

  <diagram id="Ugy8V5XuK09T1-bv1tVg" name="Index Engine">
    <mxGraphModel dx="3005" dy="1593" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph IndexEngine_Module[\&quot;Index Engine\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State\&quot;]\n            IDX[\&quot;In-Memory Index\\nunordered_map&lt;field, unordered_map&lt;value, vector&lt;Location&gt;&gt;&gt;\&quot;]\n            TTL[\&quot;Time-to-Live / Eviction Policy\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface\&quot;]\n            I1[\&quot;index(log, loc) -&gt; void\&quot;]\n            I2[\&quot;search(field, value) -&gt; vector&lt;Location&gt;\&quot;]\n            I3[\&quot;search(query) -&gt; vector&lt;Location&gt;\&quot;]\n            I4[\&quot;flush() -&gt; void (to disk)\&quot;]\n            I5[\&quot;rebuild(storage) -&gt; void\&quot;]\n        end\n\n        subgraph Index_Logic[\&quot;index() Logic\&quot;]\n            IDX1[\&quot;Extract indexed fields from ProcessedLog\&quot;]\n            IDX2[\&quot;For each (field, value):\&quot;]\n            IDX3[\&quot;Append loc to posting list\&quot;]\n            IDX4[\&quot;(If memory limit hit, trigger flush)\&quot;]\n            \n            IDX1 --&gt; IDX2 --&gt; IDX3 --&gt; IDX4\n        end\n\n        subgraph Search_Logic[\&quot;search() Logic\&quot;]\n            S1[\&quot;Parse Query\&quot;]\n            S2{\&quot;Multiple fields?\&quot;}\n            S3[\&quot;Get posting list for field=value\&quot;]\n            S4[\&quot;Intersect posting lists (AND)\&quot;]\n            S5[\&quot;Union posting lists (OR)\&quot;]\n            S6[\&quot;Return vector&lt;Location&gt;\&quot;]\n            \n            S1 --&gt; S2\n            S2 -- Single --&gt; S3 --&gt; S6\n            S2 -- Multi --&gt; S4 --&gt; S6\n        end\n\n        I1 --&gt; Index_Logic\n        I2 --&gt; Search_Logic\n        I3 --&gt; Search_Logic\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="THltTp79w_8B4Fk0Zbpn-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

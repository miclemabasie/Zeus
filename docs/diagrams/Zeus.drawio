        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph WorkerPool_Module[\&quot;Worker Pool\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State\&quot;]\n            W1[\&quot;std::vector&lt;std::thread&gt; workers_\&quot;]\n            W2[\&quot;std::atomic&lt;bool&gt; running_\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface\&quot;]\n            P1[\&quot;start(num_workers) -&gt; void\&quot;]\n            P2[\&quot;stop() -&gt; void (graceful)\&quot;]\n            P3[\&quot;join() -&gt; void (wait for termination)\&quot;]\n        end\n\n        subgraph Main_Loop[\&quot;Main Loop\&quot;]\n            M1[\&quot;spawn N threads\&quot;]\n            M2[\&quot;workerLoop() -&gt; void\&quot;]\n            M3{\&quot;running_ == true?\&quot;}\n            M4[\&quot;queue-&gt;pop(log) (blocking)\&quot;]\n            M5[\&quot;ProcessingEngine-&gt;process(log)\&quot;]\n            M6[\&quot;Exit thread\&quot;]\n            \n            M1 --&gt; M2\n            M2 --&gt; M3\n            M3 -- Yes --&gt; M4 --&gt; M5 --&gt; M3\n            M3 -- No --&gt; M6\n        end\n\n        subgraph Shutdown_Flow[\&quot;Graceful Shutdown\&quot;]\n            S1[\&quot;stop() sets running_ = false\&quot;]\n            S2[\&quot;Notify condition variable (queue)\&quot;]\n            S3[\&quot;Workers finish current msg\&quot;]\n            S4[\&quot;Workers exit loop\&quot;]\n            S5[\&quot;join() waits for all threads\&quot;]\n            \n            S1 --&gt; S2 --&gt; S3 --&gt; S4 --&gt; S5\n        end\n\n        P1 --&gt; M1\n        P2 --&gt; S1\n        P3 --&gt; S5\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="i8EAcDxe_nCuYNJshT97-1">

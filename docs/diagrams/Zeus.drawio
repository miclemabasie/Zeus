  <diagram id="D3sHqElJMhNAPHn3tZU_" name="Queue (Thread-Safe)">
    <mxGraphModel dx="2828" dy="1752" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph Queue_Module[\&quot;Queue (Thread-Safe)\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State / Resources\&quot;]\n            Q1[\&quot;std::queue&lt;LogMessage&gt; (or ring buffer)\&quot;]\n            Q2[\&quot;std::mutex mtx_\&quot;]\n            Q3[\&quot;std::condition_variable cv_\&quot;]\n            Q4[\&quot;size_t max_size_\&quot;]\n            Q5[\&quot;std::atomic&lt;size_t&gt; current_size_\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface\&quot;]\n            I1[\&quot;push(msg) -&gt; bool\\n(Non-blocking, returns false if full)\&quot;]\n            I2[\&quot;push(msg) -&gt; bool\\n(Blocking with timeout)\&quot;]\n            I3[\&quot;pop(out) -&gt; bool\\n(Blocks until available)\&quot;]\n            I4[\&quot;size() -&gt; size_t\&quot;]\n            I5[\&quot;empty() -&gt; bool\&quot;]\n            I6[\&quot;clear() -&gt; void\&quot;]\n        end\n\n        subgraph Push_Logic[\&quot;Push Logic\&quot;]\n            P1[\&quot;Lock mutex\&quot;]\n            P2{\&quot;size &lt; max_size?\&quot;}\n            P3[\&quot;Push to queue\&quot;]\n            P4[\&quot;cv_.notify_one()\&quot;]\n            P5[\&quot;Unlock mutex\&quot;]\n            P6[\&quot;Return false / Block\&quot;]\n            \n            P1 --&gt; P2\n            P2 -- Yes --&gt; P3 --&gt; P4 --&gt; P5\n            P2 -- No --&gt; P6\n        end\n\n        subgraph Pop_Logic[\&quot;Pop Logic\&quot;]\n            R1[\&quot;Lock mutex\&quot;]\n            R2{\&quot;queue.empty()?\&quot;}\n            R3[\&quot;Wait on cv_ (with timeout)\&quot;]\n            R4[\&quot;Pop from queue\&quot;]\n            R5[\&quot;Unlock mutex\&quot;]\n            R6[\&quot;Return true / false\&quot;]\n            \n            R1 --&gt; R2\n            R2 -- Yes --&gt; R3 --&gt; R2\n            R2 -- No --&gt; R4 --&gt; R5 --&gt; R6\n        end\n\n        I1 -.-&gt; P1\n        I3 -.-&gt; R1\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0-d2SgPr9SRI75F-fflK-1">

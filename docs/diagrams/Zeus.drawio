        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    subgraph StorageEngine_Module[\&quot;Storage Engine\&quot;]\n        direction TB\n        \n        subgraph Internal_State[\&quot;State\&quot;]\n            DIR[\&quot;data_dir_ (string)\&quot;]\n            SEG_ID[\&quot;current_segment_id_ (uint64_t)\&quot;]\n            FILE[\&quot;current_ofstream_ (active segment)\&quot;]\n            OFFSET[\&quot;current_offset_ (size_t)\&quot;]\n            MANIFEST[\&quot;Segment Manifest\\n(map segment_id -&gt; filename, range)\&quot;]\n        end\n\n        subgraph Exposed_Interface[\&quot;Public Interface\&quot;]\n            I1[\&quot;append(log) -&gt; StorageLocation\\n(segment_id, offset)\&quot;]\n            I2[\&quot;read(loc) -&gt; ProcessedLog\&quot;]\n            I3[\&quot;flush() -&gt; void\&quot;]\n            I4[\&quot;rotate() -&gt; void\&quot;]\n            I5[\&quot;listSegments() -&gt; vector&lt;SegmentInfo&gt;\&quot;]\n        end\n\n        subgraph Append_Flow[\&quot;append() Internal Logic\&quot;]\n            A1[\&quot;Serialize ProcessedLog to bytes\&quot;]\n            A2[\&quot;Write bytes to current_file_\&quot;]\n            A3[\&quot;fsync (optional, if durability required)\&quot;]\n            A4[\&quot;Update current_offset_\&quot;]\n            A5{\&quot;Segment size &gt; max_size?\&quot;}\n            A6[\&quot;Call rotate() automatically\&quot;]\n            A7[\&quot;Return StorageLocation\&quot;]\n            \n            A1 --&gt; A2 --&gt; A3 --&gt; A4 --&gt; A5\n            A5 -- Yes --&gt; A6 --&gt; A7\n            A5 -- No --&gt; A7\n        end\n\n        subgraph Rotate_Flow[\&quot;rotate() Internal Logic\&quot;]\n            R1[\&quot;Close current_file_\&quot;]\n            R2[\&quot;Optionally compress segment\&quot;]\n            R3[\&quot;Update Manifest\&quot;]\n            R4[\&quot;Increment SEG_ID\&quot;]\n            R5[\&quot;Open new segment file\&quot;]\n            R6[\&quot;Reset OFFSET to 0\&quot;]\n            \n            R1 --&gt; R2 --&gt; R3 --&gt; R4 --&gt; R5 --&gt; R6\n        end\n\n        I1 --&gt; Append_Flow\n        I4 --&gt; Rotate_Flow\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NBP9p0xcOPQOkItI8peY-1">
